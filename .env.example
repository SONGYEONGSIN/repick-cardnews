# 인스타그램 캐러셀 게시(POST /api/publish)에 필요한 값. 실제 값은 이 파일이 아니라
# .env.local 에 넣는다(.gitignore 에 이미 있어 커밋되지 않는다). 셋 중 하나라도 없으면
# /api/publish 는 게시를 시도하지 않고 무엇이 없는지 한국어로 알려준다.

# 이 서버의 카드 이미지가 인터넷에서 닿는 공개 주소. 인스타그램 서버가 이 주소로 직접
# 사진을 가져가므로 로컬 PC 주소(localhost, 192.168.x.x)로는 동작하지 않는다 —
# ngrok 같은 터널 도구나 실제 배포 주소가 필요하다. 예: https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# 게시할 인스타그램 비즈니스(또는 크리에이터) 계정의 ID. Graph API 의 {ig-user-id}.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# 위 계정에 미디어 게시 권한이 있는 장기(long-lived) 액세스 토큰. 절대 커밋하지 않는다.
INSTAGRAM_ACCESS_TOKEN=
