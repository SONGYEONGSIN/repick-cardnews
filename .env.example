# 인스타그램 캐러셀 게시(POST /api/publish)에 필요한 값. 실제 값은 이 파일이 아니라
# .env.local 에 넣는다(.gitignore 에 이미 있어 커밋되지 않는다). 셋 중 하나라도 없으면
# /api/publish 는 게시를 시도하지 않고 무엇이 없는지 한국어로 알려준다.

# **더 이상 필요 없다.** 인스타그램이 Blob 주소에서 직접 가져가므로 우리 주소를 알 필요가
# 없다(2026-08-09). 남겨 둔 것은 옛 설정을 쓰던 사람이 헷갈리지 않게 하기 위해서다.
# PUBLIC_BASE_URL=

# 게시할 인스타그램 비즈니스(또는 크리에이터) 계정의 ID. Graph API 의 {ig-user-id}.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# 위 계정에 미디어 게시 권한이 있는 장기(long-lived) 액세스 토큰. 절대 커밋하지 않는다.
INSTAGRAM_ACCESS_TOKEN=

# 트렌드 주제 가져오기(GET /api/topics)에 필요한 값. 자세한 발급 절차는 docs/trend-setup.md.
# 필수는 YOUTUBE_API_KEY 하나뿐이다 — 없으면 파이프라인을 시작하지 않고 한국어로 알려준다.
# NAVER_CLIENT_ID·NAVER_CLIENT_SECRET 은 선택이다(둘 다 있어야 쓰인다) — 없으면 데이터랩
# 순위 매기기 단계를 조용히 건너뛰고 Claude 가 매긴 순위로 대신한다.

# 유튜브 Data API v3 키(OAuth 불필요). videos.list(chart=mostPopular, regionCode=KR)로
# 인기 급상승 후보를 가져오는 데 쓴다. 발급: console.cloud.google.com.
YOUTUBE_API_KEY=

# 네이버 오픈API 애플리케이션의 클라이언트 ID(선택). 데이터랩 검색어트렌드 API 호출에 쓴다.
# 발급: developers.naver.com. 2026-08-02 기준 앱 등록 화면에 데이터랩이 안 보일 수 있다 —
# docs/trend-setup.md 참고.
NAVER_CLIENT_ID=

# 위 애플리케이션의 클라이언트 시크릿(선택). 절대 커밋하지 않는다.
NAVER_CLIENT_SECRET=

# 카피 생성이 부르는 claude 실행 파일의 경로(선택). **macOS·Linux 는 비워 둔다** — PATH 의
# `claude` 를 그대로 쓴다.
#
# Windows 에서만 필요하다. npm 전역 bin 에는 `claude`(bash 스크립트)·`claude.cmd`·`claude.ps1`
# 만 있고 Windows 가 실행 파일로 인정하는 `.exe` 가 없어 그냥은 실행되지 않는다. 실제 실행
# 파일은 한 단계 안쪽에 있다 — 아래 경로에서 `ys1114` 를 자기 사용자 이름으로 바꾼다.
# 확인: 탐색기에 %APPDATA%\npm\node_modules\@anthropic-ai\claude-code\bin 을 붙여 넣어 본다.
# CLAUDE_CLI_PATH=C:/Users/ys1114/AppData/Roaming/npm/node_modules/@anthropic-ai/claude-code/bin/claude.exe

# ── 로그인 (배포에 필수) ──────────────────────────────────────────
#
# 인터넷에 올린 순간 주소를 아는 누구나 이 스튜디오에 닿는다. 여기 값이 없으면 미들웨어가
# **아무도 들여보내지 않는다**(`src/middleware.ts`) — 설정을 빠뜨렸을 때 열리는 쪽으로
# 실패하면 인스타 계정이 통째로 열리기 때문이다.

# 들어갈 때 치는 비밀번호. **사람이 외우는 값이 아니라 붙여넣는 값이다** — 해시하지 않으므로
# 대입 공격을 길이로 막는다. 만들기:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
APP_PASSWORD=

# 로그인 쿠키에 서명하는 키. 바꾸면 기존 로그인이 전부 풀린다. 만들기:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 카피 생성용 오래 사는 OAuth 토큰(배포에서만 필요). 로컬은 `claude` 로그인 세션을 쓰므로
# 비워 둔다. 만들기: 터미널에서 `claude setup-token`.
# API 키가 아니다 — 구독 자격에 붙은 토큰이다.
REPICK_CLAUDE_OAUTH_TOKEN=

# 밖에서 오는 cron(cron-job.org)이 /api/cron/tick 을 열 때 쓰는 비밀.
# 이 경로는 로그인 예외라서 **이 값이 유일한 문지기**다 — 없으면 아무도 못 들어온다.
# Vercel 쪽은 Sensitive 라 저장하면 다시 못 읽으므로 여기에도 사본을 둔다. 만들기:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── 쿠팡 파트너스 (선택) ──────────────────────────────────────────

# 소재 찾기의 "요즘 잘 팔리는 것" 신호. 없으면 그 모드만 잠기고 나머지는 그대로 돈다.
# 쿠팡 파트너스 > 내 정보 > API 관리에서 발급한다(제휴 승인 계정만 발급된다).
# 판매자용 WING API 와 다른 것이다 — WING 키로는 안 된다.
COUPANG_ACCESS_KEY=

# 위 액세스 키의 시크릿. 요청마다 HMAC 서명을 만드는 데 쓴다. 절대 커밋하지 않는다.
COUPANG_SECRET_KEY=
